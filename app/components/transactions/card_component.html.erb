<%= link_to edit_transaction_path(transaction), target: "_top", class: "grid max-w-lg gap-2 rounded border border-gray-200 bg-white p-4 shadow lg:max-w-full lg:grid-cols-3" do %>
  <p class="font-normal text-gray-900"><%= transaction.title %></p>

  <div class="">
    <h5 class="text-base font-semibold tracking-tight" style="color: <%= transaction_color %>;">
      <%= amount_formated %>
    </h5>
  </div>

  <div class="flex flex-row items-center justify-between text-xs">
    <div class="flex gap-1" style="color: <%= transaction_category_color %>;">
      <%= mdn_icon(name: :tag, class: "h-4 w-4") if transaction.category %>
      <span><%= category_title %></span>
    </div>
    <div class="text-gray-500"><%= transaction.transaction_date.strftime("%d %b %y") %></div>
  </div>
<% end %>
